		dataType : 'json',
		url : `${apiPath}/wp-admin/admin-ajax.php`,
		data : { action: 'add_cart_items' , id : id },
		success: function(response) {
			hideLoader();
			console.log('Response',response);
			updateCart(response.cart);
			if(showCart)
				toggleCart();
		}
	});
}

