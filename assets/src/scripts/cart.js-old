import { showLoader,hideLoader } from './loader.js';

var apiPath = process.env.NODE_ENV == 'production' ? 'https://zantyes.com' : 'https://localhost/zantyes';

export function addToCart(id,showCart){
	showLoader();
	jQuery.ajax({
		type : 'POST',
		dataType : 'json',
		url : `${apiPath}/wp-admin/admin-ajax.php`,
		data : { action: 'add_cart_items' , id : id },
		success: function(response) {
			hideLoader();
			console.log('Response',response);
			updateCart(response.cart);
			if(showCart)
				toggleCart();
		},error: function(){
			hideLoader()
		}
	});
}

export function removeFromCart(id,quantity){
	showLoader();
	jQuery.ajax({
		type : 'POST',
		dataType : 'json',
		url : `${apiPath}/wp-admin/admin-ajax.php`,
		data : { action: 'remove_cart_items' , id : id , quantity : quantity },
		success: function(response) {
			hideLoader();
			updateCart(response.cart);
		},error: function(){
			hideLoader()
		}
	});
}

export function toggleCart(){
	jQuery('#zsiCart').toggleClass('show');
    jQuery('body').toggleClass('hideScroll');
	jQuery('#zsiBackground').fadeToggle();
}

export function getCartItems(){
	jQuery.ajax({
		type : 'POST',
		dataType : 'json',
		url : `${apiPath}/wp-admin/admin-ajax.php`,
		data : { action: 'get_cart_items' },
		success: function(response) {
			console.log('Response',response);
			updateCart(response.cart)
		}	
	});
}

export function updateCart(cartItems){
	if(cartItems.length > 0){
		var cartContent = '';
		var total = 0;
		localStorage.setItem('items',JSON.stringify(cartItems));
		cartItems.forEach( cartItem => {
			if(Number(cartItem.quantity) > 0){
				cartContent = cartContent + `
				<div class="cartItem">
					<img src="${ cartItem.thumbnail }">
					<div>
						<h5>
							${ cartItem.product_name }
						</h5>
						<h6 class="text-danger">
							₹${ cartItem.price * cartItem.quantity } ( ₹${ cartItem.price } x ${ cartItem.quantity } )
						</h6>
					</div>
					<div class="d-flex flex-vertical" role="group" aria-label="Vertical button group">
						<button type="button" class="btn btn-outline-danger addToCart" data-itemname="${ cartItem.product_name }" data-itemid="${ cartItem.id }" data-itemquantity="${ cartItem.quantity }" data-itemprice="${ cartItem.price }" data-itemcategory1="${ cartItem.category }" onclick="zsi.addToCart(${ cartItem.id })">
						<i  data-itemname="${ cartItem.product_name }" data-itemid="${ cartItem.id }" data-itemquantity="${ cartItem.quantity }" data-itemprice="${ cartItem.price }" data-itemcategory1="${ cartItem.category }" class="fa-solid fa-plus">
						</i>
						</button>
						<button type="button" class="btn btn-outline-danger removeFromCart" data-itemname="${ cartItem.product_name }" data-itemid="${ cartItem.id }" data-itemquantity="1" data-itemprice="${ cartItem.price }" data-itemcategory1="${ cartItem.category }" onclick="zsi.removeFromCart(${ cartItem.id },${ cartItem.quantity - 1 })">
						<i data-itemname="${ cartItem.product_name }" data-itemid="${ cartItem.id }" data-itemquantity="1" data-itemprice="${ cartItem.price }" data-itemcategory1="${ cartItem.category }" class="fa-solid ${ cartItem.quantity == 1 ? 'fa-trash' : 'fa-minus'}">
						</i>
						</button>
					</div>
				</div>`;
            	total = total + ( cartItem.price * cartItem.quantity );
			}
        });
                
        jQuery('#zsiCartItemArea').html(cartContent);
        jQuery('#zsiCartCount').html(cartItems.length);
        jQuery('#zsiCartTotal').html('₹'+total);
        jQuery('#zsiCart').removeClass('empty');			
    } else
        jQuery('#zsiCart').addClass('empty');
}

getCartItems();
